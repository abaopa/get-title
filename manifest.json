{
  "manifest_version": 3,
  "name": "Get Page Title",
  "version": "1.1",
  "description": "Copies the title of the current page to the clipboard",
  "permissions": ["activeTab", "scripting", "clipboardWrite"],
  "action": {
    "default_title": "Copy Page Title",
    "default_popup": "popup.html"
  }
}